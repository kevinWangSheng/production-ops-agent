{
  "$defs": {
    "AccessScope": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "targets": {
          "items": {
            "discriminator": {
              "mapping": {
                "compose": "#/$defs/ComposeTarget",
                "integration": "#/$defs/IntegrationTarget",
                "kubernetes": "#/$defs/KubernetesTarget"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KubernetesTarget"
              },
              {
                "$ref": "#/$defs/ComposeTarget"
              },
              {
                "$ref": "#/$defs/IntegrationTarget"
              }
            ]
          },
          "title": "Targets",
          "type": "array"
        },
        "interfaces": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Interfaces",
          "type": "array"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "services": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "revision",
        "targets",
        "interfaces",
        "window"
      ],
      "title": "AccessScope",
      "type": "object"
    },
    "Action": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "query",
            "mutate",
            "release_gate"
          ],
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "compose": "#/$defs/ComposeTarget",
              "integration": "#/$defs/IntegrationTarget",
              "kubernetes": "#/$defs/KubernetesTarget"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KubernetesTarget"
            },
            {
              "$ref": "#/$defs/ComposeTarget"
            },
            {
              "$ref": "#/$defs/IntegrationTarget"
            }
          ],
          "title": "Target"
        },
        "interface": {
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "attempted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempted"
        },
        "authorized": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Authorized"
        },
        "executed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Executed"
        },
        "evidence_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "audit_basis": {
          "minLength": 1,
          "title": "Audit Basis",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target",
        "interface",
        "attempted",
        "authorized",
        "executed",
        "audit_basis"
      ],
      "title": "Action",
      "type": "object"
    },
    "AgentInput": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "$ref": "#/$defs/Subject"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "initial_views": {
          "items": {
            "$ref": "#/$defs/EvidenceView"
          },
          "title": "Initial Views",
          "type": "array"
        },
        "evidence_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "subject",
        "request",
        "initial_views"
      ],
      "title": "AgentInput",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "interface": {
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "targets": {
          "items": {
            "discriminator": {
              "mapping": {
                "compose": "#/$defs/ComposeTarget",
                "integration": "#/$defs/IntegrationTarget",
                "kubernetes": "#/$defs/KubernetesTarget"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KubernetesTarget"
              },
              {
                "$ref": "#/$defs/ComposeTarget"
              },
              {
                "$ref": "#/$defs/IntegrationTarget"
              }
            ]
          },
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        },
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "window": {
          "$ref": "#/$defs/Window"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "no_data",
            "stale",
            "invalid_input",
            "denied",
            "connectivity",
            "timeout",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "raw": {
          "minLength": 1,
          "title": "Raw",
          "type": "string"
        },
        "raw_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Hash",
          "type": "string"
        },
        "projection_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Revision"
        }
      },
      "required": [
        "id",
        "interface",
        "targets",
        "query",
        "window",
        "captured_at",
        "status",
        "raw",
        "raw_hash"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ComposeTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "compose",
          "title": "Kind",
          "type": "string"
        },
        "integration_id": {
          "minLength": 1,
          "title": "Integration Id",
          "type": "string"
        },
        "deployment_instance": {
          "minLength": 1,
          "title": "Deployment Instance",
          "type": "string"
        },
        "service": {
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "container_id": {
          "minLength": 1,
          "title": "Container Id",
          "type": "string"
        },
        "image_digest": {
          "minLength": 1,
          "title": "Image Digest",
          "type": "string"
        },
        "telemetry_instance": {
          "minLength": 1,
          "title": "Telemetry Instance",
          "type": "string"
        },
        "mapping_revision": {
          "minLength": 1,
          "title": "Mapping Revision",
          "type": "string"
        },
        "config_revision": {
          "minLength": 1,
          "title": "Config Revision",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "integration_id",
        "deployment_instance",
        "service",
        "container_id",
        "image_digest",
        "telemetry_instance",
        "mapping_revision",
        "config_revision"
      ],
      "title": "ComposeTarget",
      "type": "object"
    },
    "ControlEvent": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "action": {
          "enum": [
            "cancel",
            "correct",
            "new_run"
          ],
          "title": "Action",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "generation",
        "action",
        "at"
      ],
      "title": "ControlEvent",
      "type": "object"
    },
    "Delivery": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "control_generation": {
          "minimum": 0,
          "title": "Control Generation",
          "type": "integer"
        },
        "business_projection": {
          "enum": [
            "envelope-v1",
            "holmes-user-tool-v1"
          ],
          "title": "Business Projection",
          "type": "string"
        },
        "business_projection_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Business Projection Hash",
          "type": "string"
        },
        "business_projection_content": {
          "minLength": 1,
          "title": "Business Projection Content",
          "type": "string"
        },
        "full_wire_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Full Wire Hash",
          "type": "string"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/EvidenceView"
          },
          "title": "Views",
          "type": "array"
        },
        "state": {
          "enum": [
            "prepared",
            "dispatched",
            "response_committed"
          ],
          "title": "State",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/EvidenceContext"
        },
        "dispatch_started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispatch Started At"
        },
        "response_received_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Received At"
        }
      },
      "required": [
        "run_id",
        "step_id",
        "request_id",
        "control_generation",
        "business_projection",
        "business_projection_hash",
        "business_projection_content",
        "full_wire_hash",
        "views",
        "state",
        "context"
      ],
      "title": "Delivery",
      "type": "object"
    },
    "EvidenceContext": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "opspilot-evidence-context-v4",
          "default": "opspilot-evidence-context-v4",
          "title": "Type",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "target_catalog": {
          "additionalProperties": {
            "discriminator": {
              "mapping": {
                "compose": "#/$defs/ComposeTarget",
                "integration": "#/$defs/IntegrationTarget",
                "kubernetes": "#/$defs/KubernetesTarget"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/KubernetesTarget"
              },
              {
                "$ref": "#/$defs/ComposeTarget"
              },
              {
                "$ref": "#/$defs/IntegrationTarget"
              }
            ]
          },
          "title": "Target Catalog",
          "type": "object"
        },
        "view_bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/ViewBinding"
          },
          "title": "View Bindings",
          "type": "object"
        },
        "time_policies": {
          "items": {
            "$ref": "#/$defs/TimePolicy"
          },
          "title": "Time Policies",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "target_catalog",
        "view_bindings",
        "time_policies"
      ],
      "title": "EvidenceContext",
      "type": "object"
    },
    "EvidenceView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "raw_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Hash",
          "type": "string"
        },
        "projection": {
          "enum": [
            "json-fields-v1",
            "holmes-tool-v2"
          ],
          "title": "Projection",
          "type": "string"
        },
        "fields": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "view_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "View Hash",
          "type": "string"
        },
        "total_fields": {
          "minimum": 0,
          "title": "Total Fields",
          "type": "integer"
        },
        "retained_fields": {
          "minimum": 0,
          "title": "Retained Fields",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "context_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Hash"
        },
        "projection_source_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Source Sha256"
        },
        "projection_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Revision"
        },
        "projection_dependencies_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projection Dependencies Sha256"
        }
      },
      "required": [
        "id",
        "artifact_id",
        "raw_hash",
        "projection",
        "fields",
        "content",
        "view_hash",
        "total_fields",
        "retained_fields",
        "truncated"
      ],
      "title": "EvidenceView",
      "type": "object"
    },
    "IntegrationTarget": {
      "additionalProperties": false,
      "properties": {
        "kind": {
