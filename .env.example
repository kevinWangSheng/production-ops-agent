# M0 配置模板；显式加载器见 python -m scripts.m0 check-config。私有值不提交。
# 非秘密默认值沿用 C3；live 还需独立的私有批准合同；仅填本文件不能授权调用。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPSPILOT_MODEL=deepseek-v4-flash
OPSPILOT_THINKING=enabled
OPSPILOT_REASONING_EFFORT=high

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opspilot-m0
# 按账号项目区域填入，不能向错误区域试传业务资料。
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
# 禁止自动导出完整 state；后续仅通过经过验证的白名单 exporter。
LANGSMITH_TRACING=false

# 未授权前保持 0；额度与期限必须另有任务中的授权依据。
OPSPILOT_EXPERIMENT_BUDGET_CNY=0
OPSPILOT_EXPERIMENT_DEADLINE_UTC=
# 由助手在隔离 PostgreSQL 准备时生成/配置，不复用被调查系统数据库身份。
OPSPILOT_DATABASE_URL=
