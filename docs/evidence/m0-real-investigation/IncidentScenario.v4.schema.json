    "Subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "incident",
          "title": "Kind",
          "type": "string"
        },
        "target": {
          "discriminator": {
            "mapping": {
              "compose": "#/$defs/ComposeTarget",
              "integration": "#/$defs/IntegrationTarget",
              "kubernetes": "#/$defs/KubernetesTarget"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/KubernetesTarget"
            },
            {
              "$ref": "#/$defs/ComposeTarget"
            },
            {
              "$ref": "#/$defs/IntegrationTarget"
            }
          ],
          "title": "Target"
        }
      },
      "required": [
        "id",
        "kind",
        "target"
      ],
      "title": "Subject",
      "type": "object"
    },
    "TimePolicy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "integration_id": {
          "minLength": 1,
          "title": "Integration Id",
          "type": "string"
        },
        "interfaces": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Interfaces",
          "type": "array"
        },
        "mode": {
          "enum": [
            "historical_window",
            "current"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reference_rule": {
          "enum": [
            "dispatch_started_at",
            "response_received_at"
          ],
          "title": "Reference Rule",
          "type": "string"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_source_age_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Source Age Seconds"
        },
        "target_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Target Refs",
          "type": "array"
        },
        "all_authorized_targets": {
          "default": false,
          "title": "All Authorized Targets",
          "type": "boolean"
        },
        "scope_revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
