# 开发用私有配置模板（裸进程开发、OPSPILOT_ENV_FILE、python -m scripts.m0 check-config）。私有值不提交。
# Compose 安装不读本文件：deploy/compose/install.sh 在仓库外生成密钥目录，模型 key 写入其中的 worker_env（见 README）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPSPILOT_MODEL=deepseek-flash
OPSPILOT_THINKING=enabled
OPSPILOT_REASONING_EFFORT=high

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opspilot-m0
# 按账号项目区域填入，不能向错误区域试传业务资料。
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
# 禁止自动导出完整 state；后续仅通过经过验证的白名单 exporter。
LANGSMITH_TRACING=false

# 只有 M0 历史脚本（scripts/m0）读取这两项；真实调用已是常设授权（AGENTS.md「费用与真实调用」），不按此审批。
OPSPILOT_EXPERIMENT_BUDGET_CNY=0
OPSPILOT_EXPERIMENT_DEADLINE_UTC=
# 开发用隔离 PostgreSQL 的 DSN，不复用被调查系统的数据库身份。
OPSPILOT_DATABASE_URL=
